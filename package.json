{
  "name": "allure-report-publisher",
  "description": "Publish allure 3 reports to cloud storage providers",
  "version": "5.7.0",
  "author": "Andrejs Cunskis",
  "bin": {
    "allure-report-publisher": "bin/run.js"
  },
  "bugs": "https://github.com/andrcuns/allure-report-publisher/issues",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@gitbeaker/rest": "^43.8.0",
    "@google-cloud/storage": "^7.19.0",
    "@oclif/core": "^5.0.0",
    "allure": "^3.18.0",
    "chalk": "^6.0.0",
    "ci-info": "^4.4.0",
    "glob": "^13.0.6",
    "mime-types": "^3.0.2",
    "nano-spawn": "^2.1.0",
    "octokit": "^5.0.5",
    "p-all": "^5.0.1",
    "supports-color": "^11.0.0",
    "tty-table": "^5.0.0",
    "yaml": "^2.8.3",
    "yocto-spinner": "^1.1.0"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "5.0.2",
    "allure-js-commons": "3.12.2",
    "allure-vitest": "3.12.2",
    "dedent": "^1.7.2",
    "oclif": "^6.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.71.0",
    "shx": "^0.4.0",
    "testcontainers": "^12.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/andrcuns/allure-report-publisher",
  "keywords": [
    "oclif",
    "allure",
    "test-report"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "allure-report-publisher",
    "dirname": "allure-report-publisher",
    "commands": "./dist/commands",
    "plugins": [],
    "topicSeparator": " ",
    "helpOptions": {
      "flagSortOrder": "none"
    },
    "topics": {
      "upload": {
        "description": "Upload reports to cloud storage or CI artifacts"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrcuns/allure-report-publisher.git"
  },
  "scripts": {
    "build": "tsc -b",
    "cleanBuild": "shx rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "format": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:agent": "oxlint -f agent",
    "prepack": "oclif manifest && oclif readme",
    "postpack": "shx rm -f oclif.manifest.json",
    "test": "pnpm run build && vitest run --coverage",
    "test:unit": "pnpm run build && vitest run --project unit --coverage",
    "test:e2e": "pnpm run build && vitest run --project e2e --coverage",
    "test:watch": "pnpm run build && vitest",
    "test:typecheck": "tsc -p test/tsconfig.json",
    "version": "oclif readme && git add README.md",
    "prereadme": "shx rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "readme": "oclif readme"
  },
  "types": "dist/index.d.ts"
}
