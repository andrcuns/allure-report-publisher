{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "node", "promise", "import"],
  "categories": {
    "correctness": "error",
    "style": "error",
    "restriction": "warn",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["dist/**", "tmp/**", "reports/**", "coverage/**"],
  "rules": {
    "func-style": [
      "error",
      "declaration",
      {
        "allowArrowFunctions": true
      }
    ],
    "max-statements": ["error", 25],
    "max-params": ["error", 5],
    "id-length": ["error", {"checkGeneric": false, "exceptions": ["_"]}],
    "sort-keys": "off",
    "no-console": "off",
    "no-duplicate-imports": ["error", {"allowSeparateTypeImports": true}],
    "no-continue": "off",
    "no-magic-numbers": "off",
    "no-undefined": "off",
    "sort-imports": "off",
    "curly": "off",
    "no-ternary": "off",
    "no-underscore-dangle": "off",
    "capitalized-comments": "off",
    "init-declarations": "off",
    "one-var": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/group-exports": "off",
    "import/exports-last": "off",
    "import/no-nodejs-modules": "off",
    "import/no-relative-parent-imports": "off",
    "node/no-sync": "off",
    "node/no-process-env": "off",
    "typescript/consistent-type-definitions": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/method-signature-style": ["error", "method"],
    "typescript/explicit-member-accessibility": ["warn", {"overrides": {"constructors": "no-public"}}]
  },
  "overrides": [
    {
      "files": ["**/*.js", "**/*.mjs", "**/*.cjs"],
      "rules": {
        "no-undef": "error"
      }
    },
    {
      "files": ["src/commands/**/*.ts", "allurerc.mjs"],
      "rules": {
        "import/no-default-export": "off",
        "import/no-anonymous-default-export": "off"
      }
    },
    {
      "files": ["bin/*.js"],
      "rules": {
        "node/no-top-level-await": "off"
      }
    },
    {
      "files": ["test/**/*.ts"],
      "env": {
        "mocha": true
      },
      "rules": {
        "func-names": "off",
        "no-unused-expressions": "off",
        "import/no-namespace": "off",
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
