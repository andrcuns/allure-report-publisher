{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": false,
  "bracketSpacing": false,
  "trailingComma": "all",
  "ignorePatterns": ["dist/**", "tmp/**", "reports/**", "coverage/**", "*.json", "*.md", "*.html", "*.yml", "*.yaml"]
}
